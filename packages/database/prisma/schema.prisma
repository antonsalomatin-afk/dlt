generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum VehicleType {
  CAR
  MOTORCYCLE
}

model User {
  examSessions        ExamSession[]
  favorites           Favorite[]
  presentations       QuestionPresentation[]
  sessions            Session[]
  id                  String                 @id @default(uuid()) @db.Uuid
  telegramUserId      BigInt                 @unique
  username            String?
  firstName           String?
  selectedVehicleType VehicleType?
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)
  lastSeenAt          DateTime?              @db.Timestamptz(3)
}

enum ChoiceKey {
  A
  B
  C
  D
}

enum VerificationStatus {
  DRAFT
  VERIFIED
  REJECTED
}

enum SourceType {
  FIXTURE
  ORIGINAL
  OFFICIAL
  THIRD_PARTY
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique
  nameThai    String
  nameEnglish String
  nameRussian String
  sortOrder   Int        @default(0)
  questions   Question[]
}

model Concept {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique
  nameThai    String
  nameEnglish String
  nameRussian String
  questions   Question[]
}

model Question {
  examQuestions          ExamQuestion[]
  favorites              Favorite[]
  presentations          QuestionPresentation[]
  id                     String                 @id @default(uuid()) @db.Uuid
  vehicleType            VehicleType
  categoryId             String                 @db.Uuid
  category               Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  conceptId              String?                @db.Uuid
  concept                Concept?               @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  textThai               String?
  textExamEnglish        String?
  textEnglish            String
  textRussian            String?
  explanationThai        String?
  explanationEnglish     String?
  explanationRussian     String?
  trapExplanationThai    String?
  trapExplanationEnglish String?
  trapExplanationRussian String?
  imageReference         String?
  sourceType             SourceType
  sourceReference        String?
  sourceDate             DateTime?              @db.Date
  legalCitation          String?
  verificationStatus     VerificationStatus     @default(DRAFT)
  reviewer               String?
  reviewedAt             DateTime?              @db.Timestamptz(3)
  active                 Boolean                @default(false)
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(3)
  choices                QuestionChoice[]

  @@index([vehicleType, categoryId, active, verificationStatus])
  @@index([conceptId])
}

model QuestionChoice {
  id          String    @id @default(uuid()) @db.Uuid
  questionId  String    @db.Uuid
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key         ChoiceKey
  textThai    String?
  textEnglish String
  textRussian String?
  isCorrect   Boolean   @default(false)

  @@unique([questionId, key])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([userId])
}

model QuestionPresentation {
  answer     AnswerAttempt?
  favorites  Favorite[]
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String         @db.Uuid
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  snapshot   Json

  @@unique([id, userId, questionId])
  @@index([userId])
  @@index([questionId])
}

model Favorite {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @db.Uuid
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String               @db.Uuid
  question       Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)
  presentationId String               @db.Uuid
  presentation   QuestionPresentation @relation(fields: [presentationId, userId, questionId], references: [id, userId, questionId], onDelete: Restrict)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([userId, questionId])
  @@index([userId, updatedAt(sort: Desc), id(sort: Desc)])
}

model AnswerAttempt {
  id               String               @id @default(uuid()) @db.Uuid
  presentationId   String               @unique @db.Uuid
  presentation     QuestionPresentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  selectedChoiceId String               @db.Uuid
  isCorrect        Boolean
  submittedAt      DateTime             @default(now()) @db.Timestamptz(3)
}

model ExamSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   VehicleType
  questionCount Int            @default(50)
  passingScore  Int
  startedAt     DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime       @db.Timestamptz(3)
  completedAt   DateTime?      @db.Timestamptz(3)
  score         Int?
  passed        Boolean?
  questions     ExamQuestion[]

  @@index([userId, startedAt(sort: Desc), id(sort: Desc)])
}

model ExamQuestion {
  id               String      @id @default(uuid()) @db.Uuid
  examSessionId    String      @db.Uuid
  examSession      ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  position         Int
  questionId       String      @db.Uuid
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  snapshot         Json
  selectedChoiceId String?     @db.Uuid
  isCorrect        Boolean?
  answeredAt       DateTime?   @db.Timestamptz(3)

  @@unique([examSessionId, position])
  @@unique([examSessionId, questionId])
  @@index([questionId])
}
