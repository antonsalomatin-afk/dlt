{
  "name": "thai-dlt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "node --env-file=.env tools/database/local.ts start",
    "db:ready": "node --env-file=.env tools/database/local.ts ready",
    "db:stop": "node --env-file=.env tools/database/local.ts stop",
    "db:reset": "node --env-file=.env tools/database/local.ts reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.10.0",
    "pg": "8.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
