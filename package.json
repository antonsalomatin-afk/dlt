{
  "name": "thai-dlt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "api:start": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "bot:start": "node --env-file-if-exists=.env apps/bot/src/main.ts",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "pnpm db:generate && vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "node --env-file=.env tools/database/local.ts start",
    "db:ready": "node --env-file=.env tools/database/local.ts ready",
    "db:stop": "node --env-file=.env tools/database/local.ts stop",
    "db:reset": "node --env-file=.env tools/database/local.ts reset",
    "prisma": "node --env-file-if-exists=.env node_modules/prisma/build/index.js --config packages/database/prisma.config.ts",
    "db:generate": "pnpm prisma generate",
    "db:migrate": "pnpm prisma migrate deploy",
    "content:import": "pnpm db:generate && node --env-file=.env tools/content/import.ts",
    "test:integration": "pnpm db:generate && node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/node-fetch": "2.6.13",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.10.0",
    "node-fetch": "2.7.0",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
