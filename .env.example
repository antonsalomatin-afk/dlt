# Local development only; never reuse these example credentials in production.
# Copy to .env before running pnpm db:start. Keep host fixed to 127.0.0.1.
DATABASE_URL=postgresql://thaidlt:local-development-only@127.0.0.1:55432/thaidlt

# Optional until running the bot. Server-side only; obtain a real token separately.
# BOT_TOKEN=replace-with-your-bot-token
# MINI_APP_URL=https://your-mini-app.example/

# API uses the same server-only BOT_TOKEN. Local loopback port defaults to 3001.
# API_PORT=3001

# Server-only Next.js rewrite destination. Set in shell or apps/web/.env.local.
# API_ORIGIN=http://127.0.0.1:3001
